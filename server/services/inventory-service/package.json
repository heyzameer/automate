{
    "name": "carbot-inventory-service",
    "version": "1.0.0",
    "description": "Dynamic Inventory and Form Configuration Service for CarBot AI",
    "main": "dist/main.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/main.js",
        "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/main.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "clean": "rimraf dist",
        "prepare": "node -e \"if (process.env.NODE_ENV !== 'production') { try { require('child_process').execSync('husky') } catch (e) {} }\""
    },
    "dependencies": {
        "@carbot/common": "workspace:*",
        "@google/genai": "^1.49.0",
        "axios": "^1.15.0",
        "chalk": "^4.1.2",
        "cloudinary": "^1.41.0",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.18.2",
        "express-rate-limit": "^6.10.0",
        "helmet": "^7.0.0",
        "ioredis": "^5.9.2",
        "joi": "^17.11.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^7.6.3",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "multer-storage-cloudinary": "^4.0.0",
        "node-cron": "^4.2.1",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.10.0"
    },
    "devDependencies": {
        "@types/compression": "^1.7.4",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.15",
        "@types/express": "^4.17.20",
        "@types/jest": "^29.5.6",
        "@types/jsonwebtoken": "^9.0.4",
        "@types/morgan": "^1.9.7",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.8.6",
        "@types/node-cron": "^3.0.11",
        "@types/supertest": "^2.0.15",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "eslint": "^8.57.1",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "rimraf": "^5.0.5",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.2.2"
    },
    "author": "Your Name",
    "license": "MIT"
}
