{
  "name": "carbot-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server/*",
    "packages/*",
    "app"
  ],
  "scripts": {
    "dev:auth": "npm run dev --workspace=server/auth-service",
    "dev:gateway": "npm run dev --workspace=server/api-gateway",
    "dev:frontend": "npm run dev --workspace=app",
    "dev:servers": "concurrently -c \"cyan,magenta\" \"npm run dev:auth\" \"npm run dev:gateway\"",
    "dev:all": "concurrently -c \"cyan,magenta,yellow\" \"npm run dev:auth\" \"npm run dev:gateway\" \"npm run dev:frontend\"",
    "dev": "npm run dev:all",
    "kill:ports": "npx kill-port 5000 5001 5173",
    "kill:node": "taskkill /F /IM node.exe",
    "build": "npm run build --workspaces --if-present",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "axios": "^1.13.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
